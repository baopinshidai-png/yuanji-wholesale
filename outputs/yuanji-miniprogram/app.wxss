/* ============================================================
   源集 · 设计系统（清爽白底现代电商风）
   颜色 / 圆角 / 间距 / 阴影 统一在这里，页面样式尽量只用变量
   ============================================================ */
page {
  --brand: #ff3355;
  --brand-2: #ff6584;
  --brand-soft: #fff0f3;
  --price: #ff2f4f;
  --green: #0fb87a;
  --green-soft: #eafaf3;
  --orange: #ff8a00;
  --orange-soft: #fff5e8;
  --text: #17171c;
  --text-2: #62626e;
  --text-3: #9c9ca6;
  --line: #eeeef2;
  --bg: #f6f7f9;
  --radius: 24rpx;
  --radius-sm: 16rpx;
  --radius-xs: 12rpx;
  --shadow: 0 2rpx 14rpx rgba(17, 17, 30, 0.05);
  background: var(--bg);
  color: var(--text);
  font-size: 28rpx;
  line-height: 1.45;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", "Microsoft YaHei", sans-serif;
  -webkit-font-smoothing: antialiased;
}

view,
text,
image,
scroll-view {
  box-sizing: border-box;
}

.page {
  padding-bottom: 140rpx;
}

/* ---------- 卡片 ---------- */
.card {
  background: #fff;
  border-radius: var(--radius);
  margin: 20rpx 24rpx;
  padding: 24rpx;
  box-shadow: var(--shadow);
}

.card-flush {
  padding: 0;
  overflow: hidden;
}

.hairline {
  height: 1rpx;
  background: var(--line);
  margin: 20rpx 0;
}

/* ---------- 排版 ---------- */
.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.muted {
  color: var(--text-3);
  font-size: 22rpx;
}

.strong {
  font-weight: 600;
}

.sec-head {
  display: flex;
  align-items: center;
  padding: 4rpx 4rpx 20rpx;
}

.sec-title {
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 0.5rpx;
}

.sec-title .sub {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--text-3);
  margin-left: 12rpx;
}

.sec-more {
  margin-left: auto;
  font-size: 24rpx;
  color: var(--text-3);
}

/* ---------- 价格 ---------- */
.price {
  color: var(--price);
  font-weight: 700;
}

.price .rmb {
  font-size: 22rpx;
  margin-right: 2rpx;
}

.price-lg {
  font-size: 44rpx;
  line-height: 1;
}

.strike {
  color: var(--text-3);
  font-size: 22rpx;
  text-decoration: line-through;
}

/* ---------- 标签 ---------- */
.tag {
  display: inline-block;
  font-size: 20rpx;
  line-height: 1;
  padding: 7rpx 12rpx;
  border-radius: 8rpx;
  color: var(--brand);
  background: var(--brand-soft);
  margin-right: 8rpx;
}

.tag.plain {
  color: var(--text-2);
  background: #f4f4f7;
}

.tag.solid {
  color: #fff;
  background: var(--brand);
}

.tag.green {
  color: var(--green);
  background: var(--green-soft);
}

.tag.orange {
  color: var(--orange);
  background: var(--orange-soft);
}

.tag.line {
  background: #fff;
  color: var(--brand);
  border: 1rpx solid rgba(255, 51, 85, 0.35);
}

/* ---------- 按钮 ---------- */
.btn-primary {
  background: linear-gradient(96deg, #ff5c7a, var(--brand));
  color: #fff;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
  padding: 22rpx 0;
  box-shadow: 0 10rpx 24rpx rgba(255, 51, 85, 0.24);
}

.btn-ghost {
  color: var(--brand);
  border: 2rpx solid rgba(255, 51, 85, 0.45);
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
  padding: 18rpx 0;
  background: #fff;
}

.btn-plain {
  background: #f4f4f7;
  color: var(--text-2);
  border-radius: 999rpx;
  font-size: 26rpx;
  text-align: center;
  padding: 16rpx 0;
}

.btn-mini {
  display: inline-block;
  font-size: 24rpx;
  font-weight: 600;
  color: #fff;
  background: linear-gradient(96deg, #ff5c7a, var(--brand));
  border-radius: 999rpx;
  padding: 12rpx 32rpx;
}

.btn-mini.ghost {
  background: #fff;
  color: var(--brand);
  border: 2rpx solid rgba(255, 51, 85, 0.4);
  font-weight: 500;
}

/* ---------- 顶部自定义导航栏 ---------- */
.nav {
  background: #fff;
}

.nav-inner {
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  font-size: 32rpx;
  font-weight: 600;
}

.nav-back {
  position: absolute;
  left: 20rpx;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  font-size: 40rpx;
  color: var(--text);
  line-height: 1;
}

.nav-right {
  position: absolute;
  /* 右上角要让开微信胶囊按钮 */
  right: 190rpx;
  font-size: 26rpx;
  color: var(--text-2);
}

/* ---------- 搜索框 ---------- */
.searchbar {
  display: flex;
  align-items: center;
  height: 76rpx;
  background: #f4f4f7;
  border-radius: 999rpx;
  padding: 0 24rpx;
  color: var(--text-3);
  font-size: 26rpx;
}

.searchbar .icon {
  margin-right: 12rpx;
  font-size: 26rpx;
}

.icon-img {
  width: 36rpx;
  height: 36rpx;
  flex: none;
}

.icon-img.sm {
  width: 30rpx;
  height: 30rpx;
}

.icon-img.lg {
  width: 52rpx;
  height: 52rpx;
}

.searchbar .scan {
  margin-left: auto;
  color: var(--text-2);
  font-size: 24rpx;
  display: flex;
  align-items: center;
  padding-left: 20rpx;
  border-left: 1rpx solid #e3e3e8;
}

/* ---------- 商品双列 ---------- */
.ggrid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 16rpx;
}

.ggrid .cell {
  width: 50%;
  box-sizing: border-box;
  padding: 8rpx;
}

/* ---------- 横向筛选 chips ---------- */
.chips {
  white-space: nowrap;
  padding: 20rpx 24rpx 4rpx;
}

.chip {
  display: inline-block;
  font-size: 26rpx;
  color: var(--text-2);
  padding: 12rpx 26rpx;
  margin-right: 16rpx;
  border-radius: 999rpx;
  background: #fff;
  box-shadow: var(--shadow);
}

.chip.on {
  color: #fff;
  font-weight: 600;
  background: linear-gradient(96deg, #ff5c7a, var(--brand));
  box-shadow: 0 8rpx 18rpx rgba(255, 51, 85, 0.24);
}

/* ---------- 底部固定条 ---------- */
.fixed-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-top: 1rpx solid var(--line);
  z-index: 20;
  padding-bottom: env(safe-area-inset-bottom);
}

.login-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  color: var(--text);
  font-size: 26rpx;
}

.login-bar .tip {
  color: var(--text-2);
}

.login-bar .go {
  background: linear-gradient(96deg, #ff5c7a, var(--brand));
  color: #fff;
  border-radius: 999rpx;
  padding: 14rpx 36rpx;
  font-size: 26rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 20rpx rgba(255, 51, 85, 0.22);
}

/* ---------- 空状态 ---------- */
.empty {
  padding: 140rpx 60rpx 120rpx;
  text-align: center;
}

.empty .empty-img {
  width: 128rpx;
  height: 128rpx;
  opacity: 0.35;
}

.empty .t {
  display: block;
  margin-top: 24rpx;
  font-size: 28rpx;
  color: var(--text-2);
}

.empty .s {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--text-3);
}

.empty .btn-mini {
  margin-top: 32rpx;
}

/* ---------- 列表行 ---------- */
.list-row {
  display: flex;
  align-items: center;
  min-height: 96rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--line);
  font-size: 28rpx;
}

.list-row:last-child {
  border-bottom: none;
}

.list-row .k {
  color: var(--text-2);
  width: 180rpx;
  flex: none;
}

.list-row .v {
  flex: 1;
  text-align: right;
  color: var(--text);
}

.list-row .arrow {
  margin-left: 12rpx;
  color: var(--text-3);
  font-size: 24rpx;
}
