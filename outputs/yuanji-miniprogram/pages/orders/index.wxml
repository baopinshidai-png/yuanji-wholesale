<view class="page od">
  <view class="nav" style="padding-top:{{statusBarHeight}}px">
    <view class="nav-inner" style="height:{{navBarHeight}}px">
      <view class="nav-back" bindtap="back">‹</view>
      我的订单
    </view>
  </view>

  <view class="tabs">
    <view class="tab {{tab === item.key ? 'on' : ''}}" wx:for="{{tabs}}" wx:key="key" data-k="{{item.key}}" bindtap="setTab">{{item.label}}</view>
  </view>

  <block wx:if="{{orders.length}}">
    <view class="card" wx:for="{{orders}}" wx:key="id">
      <view class="row-between">
        <text class="muted">订单号 {{item.id}}</text>
        <text class="status">{{item.statusText}}</text>
      </view>
      <view class="od-item" wx:for="{{item.items}}" wx:for-item="g" wx:key="goodsId" bindtap="detail" data-id="{{item.id}}">
        <image src="{{g.imgUrl}}" mode="aspectFill" />
        <view class="od-body">
          <view class="od-title">{{g.title}}</view>
          <view class="muted">{{g.color}} / {{g.size}}　{{g.stallName}}</view>
          <view class="od-price"><text class="price"><text class="rmb">¥</text>{{g.price}}</text><text class="muted">x{{g.qty}}</text></view>
        </view>
      </view>
      <view class="od-sum">
        共 {{item.count}} 件　优惠 -¥{{item.discount}}　<text class="strong">实付 ¥{{item.payable}}</text>
      </view>
      <view class="od-actions">
        <block wx:if="{{item.status === 'unpaid'}}">
          <view class="btn-mini ghost" data-id="{{item.id}}" catchtap="cancel">取消订单</view>
          <view class="btn-mini" data-id="{{item.id}}" catchtap="pay">去付款</view>
        </block>
        <block wx:elif="{{item.status === 'unship'}}">
          <view class="btn-mini ghost" data-id="{{item.id}}" catchtap="refund">申请退款</view>
          <view class="btn-mini" data-id="{{item.id}}" catchtap="ship">模拟档口发货</view>
        </block>
        <block wx:elif="{{item.status === 'shipped'}}">
          <view class="btn-mini ghost" data-id="{{item.id}}" catchtap="refund">申请退款</view>
          <view class="btn-mini" data-id="{{item.id}}" catchtap="receive">确认收货</view>
        </block>
        <block wx:elif="{{item.status === 'refunding'}}">
          <view class="btn-mini ghost" data-id="{{item.id}}" catchtap="detail">退款中，查看详情</view>
        </block>
        <block wx:else>
          <view class="btn-mini ghost" data-id="{{item.id}}" catchtap="detail">查看详情</view>
        </block>
      </view>
    </view>
  </block>

  <view class="empty" wx:else>
    <image class="empty-img" src="/images/icons/box.png" />
    <text class="t">还没有订单</text>
    <text class="s">去专场挑点好货，支持一件起批</text>
    <view class="btn-mini" bindtap="goHome">去专场挑货</view>
  </view>
</view>
