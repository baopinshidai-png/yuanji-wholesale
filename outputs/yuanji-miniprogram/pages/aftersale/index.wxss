.af-page {
  padding-bottom: 200rpx;
}

.af-head {
  background: #fff;
}

.af-nav {
  display: flex;
  align-items: center;
  padding: 0 20rpx;
}

.back {
  width: 60rpx;
  font-size: 44rpx;
  line-height: 1;
}

.af-nav-title {
  margin: 0 auto;
  font-size: 30rpx;
  font-weight: 600;
}

.af-goods {
  display: flex;
  align-items: center;
}

.af-goods image {
  width: 140rpx;
  height: 186rpx;
  border-radius: 16rpx;
  background: #f4f4f6;
  flex: none;
}

.af-goods-body {
  flex: 1;
  margin-left: 18rpx;
  min-width: 0;
}

.af-title {
  font-size: 27rpx;
  line-height: 38rpx;
  margin-bottom: 10rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.f-row {
  display: flex;
  align-items: center;
  min-height: 96rpx;
  border-bottom: 1rpx solid #eeeef2;
}

.f-row:last-child {
  border-bottom: none;
}

.f-row.column {
  flex-direction: column;
  align-items: flex-start;
  padding: 20rpx 0;
}

.f-label {
  width: 200rpx;
  flex: none;
  font-size: 27rpx;
  color: #62626e;
}

.f-row input {
  flex: 1;
  font-size: 27rpx;
}

.f-row picker {
  flex: 1;
}

.f-picker {
  font-size: 27rpx;
}

.af-textarea {
  width: 100%;
  height: 180rpx;
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 40rpx;
  background: #f6f7f9;
  border-radius: 16rpx;
  padding: 20rpx;
  box-sizing: border-box;
}

.af-imgs {
  display: flex;
  flex-wrap: wrap;
  margin-top: 20rpx;
}

.af-img,
.af-upload {
  position: relative;
  width: 180rpx;
  height: 180rpx;
  border-radius: 16rpx;
  overflow: hidden;
  margin: 0 16rpx 16rpx 0;
  background: #f6f7f9;
}

.af-img image {
  width: 100%;
  height: 100%;
}

.af-img-del {
  position: absolute;
  right: 6rpx;
  top: 6rpx;
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(17, 17, 24, 0.55);
  color: #fff;
  font-size: 22rpx;
}

.af-upload {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #9c9ca6;
}

.af-upload .plus {
  font-size: 46rpx;
  line-height: 1;
  color: #d8d8dd;
}

.af-upload .tip {
  font-size: 21rpx;
  margin-top: 8rpx;
}

.af-tip {
  margin: 8rpx 32rpx 0;
  font-size: 22rpx;
  color: #9c9ca6;
  line-height: 36rpx;
}

.af-bar {
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
}

.af-btn.off {
  opacity: 0.6;
}
