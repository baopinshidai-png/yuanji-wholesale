<view class="page doc-page">
  <view class="doc-head" style="padding-top:{{statusBarHeight}}px">
    <view class="doc-nav" style="height:{{navBarHeight}}px">
      <view class="back" bindtap="back">‹</view>
      <view class="doc-nav-title">协议与政策</view>
    </view>
    <view class="doc-tabs">
      <view class="doc-tab {{type === 'terms' ? 'on' : ''}}" data-type="terms" bindtap="switchDoc">用户协议</view>
      <view class="doc-tab {{type === 'privacy' ? 'on' : ''}}" data-type="privacy" bindtap="switchDoc">隐私政策</view>
      <view class="doc-tab {{type === 'cert' ? 'on' : ''}}" data-type="cert" bindtap="switchDoc">认证须知</view>
    </view>
  </view>

  <view class="doc-body">
    <view class="doc-title">{{title}}</view>
    <view class="doc-updated">{{updated}}</view>
    <view class="doc-sec" wx:for="{{sections}}" wx:key="h">
      <view class="doc-h">{{item.h}}</view>
      <view class="doc-p">{{item.p}}</view>
    </view>
    <view class="doc-foot">如对以上内容有疑问，可通过「我的 — 联系客服」与我们联系。</view>
  </view>
</view>
