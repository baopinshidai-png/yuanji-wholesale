.odt {
  padding-bottom: 180rpx;
}

.hero {
  background: linear-gradient(135deg, #fff5f7, #ffe9ee);
  padding: 32rpx 32rpx 40rpx;
}

.hero-status {
  font-size: 40rpx;
  font-weight: 700;
  color: #d81b47;
}

.hero-tip {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #b5566a;
}

.row-title {
  font-size: 29rpx;
  font-weight: 600;
}

.addr-line {
  display: flex;
  align-items: baseline;
  margin-top: 16rpx;
}

.addr-name {
  font-size: 29rpx;
  font-weight: 600;
}

.addr-line .muted {
  margin-left: 16rpx;
}

.addr-detail {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #62626e;
  line-height: 36rpx;
}

.odt-item {
  display: flex;
  padding-top: 20rpx;
}

.odt-item image {
  width: 150rpx;
  height: 200rpx;
  border-radius: 16rpx;
  background: #f4f4f6;
  flex: none;
}

.odt-body {
  flex: 1;
  margin-left: 20rpx;
  min-width: 0;
}

.odt-title {
  font-size: 27rpx;
  line-height: 38rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.odt-price {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-top: 14rpx;
}

.odt-price .price {
  font-size: 32rpx;
}

.amt {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  color: #62626e;
  padding: 14rpx 0;
}

.amt.strong {
  color: #17171c;
  font-weight: 700;
  font-size: 28rpx;
}

.amt:first-of-type {
  margin-top: 12rpx;
}

.minus {
  color: #ff2f4f;
}

.odt-bar {
  display: flex;
  justify-content: flex-end;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
}

.odt-btn {
  width: 300rpx;
  text-align: center;
  color: #fff;
  font-size: 29rpx;
  font-weight: 600;
  padding: 24rpx 0;
  border-radius: 999rpx;
  background: linear-gradient(96deg, #ff5c7a, #ff3355);
  box-shadow: 0 10rpx 24rpx rgba(255, 51, 85, 0.24);
}

.odt-btn.ghost {
  width: 220rpx;
  margin-right: 20rpx;
  color: #62626e;
  background: #f4f4f7;
  box-shadow: none;
}

.trace {
  margin-top: 20rpx;
  border-top: 1rpx solid #f2f2f5;
  padding-top: 12rpx;
}

.trace-item {
  display: flex;
  padding: 14rpx 0;
  position: relative;
}

.trace-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #d8d8dd;
  margin: 10rpx 20rpx 0 0;
  flex: none;
}

.trace-item.on .trace-dot {
  background: #ff3355;
  box-shadow: 0 0 0 6rpx rgba(255, 51, 85, 0.12);
}

.trace-body {
  flex: 1;
}

.trace-text {
  display: block;
  font-size: 25rpx;
  line-height: 36rpx;
}

.trace-item.on .trace-text {
  color: #ff3355;
  font-weight: 600;
}

.trace-time {
  display: block;
  margin-top: 4rpx;
  font-size: 21rpx;
  color: #9c9ca6;
}
